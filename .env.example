# Copy to .env.local. Leave the two Supabase values empty to run the clickable prototype (mock staff login).
# Supabase → Project Settings → API Keys. Publishable key only — never the secret/service key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# FastAPI base URL that /api/v1 is proxied to (server side only)
API_URL=http://localhost:8000
